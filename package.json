    "build:dev": "vite build --mode development && bun scripts/write-worker-entry.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=4",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundary": "bun scripts/check-open-source-boundary.ts",
    "check": "bun run check:boundary && bun run typecheck && bun run test:run && bun run build",
    "deploy:dry-run": "bun scripts/verify-deployment-env.ts production && bun run build && wrangler deploy --dry-run",
    "deploy:cloudflare": "bun scripts/verify-deployment-env.ts production && bun run build && wrangler deploy --keep-vars"
