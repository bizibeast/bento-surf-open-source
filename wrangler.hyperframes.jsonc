{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento-hyperframes",
  "main": "scripts/studio-hyperframes-renderer/cloudflare.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["STUDIO_REEL_RENDERER_TOKEN"],
  },
  "vars": {
    "RENDERER_ENABLED": "false",
  },
  "containers": [
    {
      "class_name": "HyperframesRenderer",
      "image": "./scripts/studio-hyperframes-renderer/Dockerfile",
      "image_build_context": ".",
      "max_instances": 2,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 4000,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HYPERFRAMES_RENDERER",
        "class_name": "HyperframesRenderer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HyperframesRenderer"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
